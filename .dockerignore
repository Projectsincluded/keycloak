# Keep the build context small. Without this, every `docker build` ships the git history to the
# daemon — 3.2 MB of `.git` for 476 KB of theme, and it grows if the checkout ever deepens.
.git
.github

# Build output and dependencies are produced inside the image, never copied in.
**/node_modules
deploy/theme/dist
deploy/theme/dist_keycloak

# Editor / OS noise
**/.DS_Store
**/*.log
